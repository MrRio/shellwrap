#!/usr/bin/env php
<?php

declare(strict_types=1);

// If we're inside someone else's project - use that autoload
if (file_exists(__DIR__ . '/../../../autoload.php')) {
    require_once __DIR__ . '/../../../autoload.php';
} else {
    require_once __DIR__ . '/../vendor/autoload.php';
}

use MrRio\ShellWrap;

$sh = new ShellWrap();

error_reporting(0);
define('SHELL_WRAP_INTERACTIVE', true);

echo "ShellWrap Interactive Shell (powered by PsySH)\n";
echo "\n";
echo 'ShellWrap instance available as $sh. Use Ctrl+D or "exit" to quit.' . "\n\n";

// Start PsySH
$shell = new \Psy\Shell();
$shell->setScopeVariables(['sh' => $sh]);

try {
    $shell->run();
} catch (\Throwable $e) {
    echo "Error: " . $e->getMessage() . "\n";
}

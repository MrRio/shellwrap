    "keywords": ["command", "shell", "api", "command-line", "exec"],
    "homepage": "http://github.com/MrRio/shellwrap",
    "license": "MIT",
    "authors": [
        {
            "name": "James Hall",
            "email": "james@snapshotmedia.co.uk",
            "homepage": "http://twitter.com/MrRio",
            "role": "Developer"
        }
    ],
    "bin": ["bin/shellwrap"],
    "require": {
        "php": "^8.1",
        "psy/psysh": "^0.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MrRio\\": "src/MrRio/"
        }
